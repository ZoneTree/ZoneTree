{
  "$schema": "https://raw.githubusercontent.com/PureStackStudio/PureStack/refs/heads/main/packages/ts-ssg/schema/siteConfig.schema.json",
  "siteTitle": "ZoneTree",
  "favicon": "iconoir:cube",
  "style": {
    "fileName": "site.css",
    "href": "/assets/site.css",
    "themes": ["light", "dark"],
    "pretty": false,
    "theme": {
      "skin": "zonetree"
    }
  },
  "auth": {
    "enabled": false,
    "signUp": false
  },
  "html": {
    "minify": true
  },
  "scripts": {
    "cacheBusting": true
  },
  "navigation": {
    "mode": "hybrid",
    "navFileName": "_nav.json",
    "maxDepth": 20,
    "includeIndex": true,
    "sortBy": "order",
    "roots": ["docs/benchmark/reference", "docs"]
  },
  "sitemap": {
    "enabled": true,
    "baseUrl": "https://zonetree.dev",
    "fileName": "sitemap.xml",
    "robots": {
      "enabled": true,
      "fileName": "robots.txt",
      "userAgent": "*",
      "allow": ["/"],
      "disallow": [],
      "crawlDelay": 2,
      "host": "zonetree.dev",
      "additionalSitemaps": [],
      "customDirectives": ["# Generated by PureStack"]
    }
  },
  "consent": {
    "enabled": true,
    "policyVersion": "2023-02-17",
    "categories": [
      {
        "id": "necessary",
        "label": "Necessary",
        "required": true
      }
    ],
    "services": []
  },
  "pagefind": {
    "enabled": true,
    "excludePaths": []
  },
  "preview": {
    "title": "ZoneTree",
    "description": "Ordered, persistent key-value storage inside your .NET application. Build indexes, event stores, and data systems with ZoneTree.",
    "image": "/docs/assets/ZoneTree-org-logo.png",
    "imageAlt": "ZoneTree storage engine logo",
    "imageWidth": 1448,
    "imageHeight": 1086,
    "siteName": "ZoneTree",
    "twitterCard": "summary_large_image"
  },
  "logo": {
    "brand": "ZoneTree",
    "subtitle": "Fastest storage for .NET",
    "letterColors": "111122",
    "subtitleLetterColors": "0",
    "colors": [
      "var(--ps-current-text-subtle)",
      "var(--ps-current-text-default)",
      "var(--ps-semantic-tone-accent-button-rest-background)",
      "#fdfdfd"
    ],
    "logoBackground": 2,
    "logoForeground": 3,
    "icon": "iconoir:cube"
  },
  "mdx": {
    "highlighter": "shiki"
  },
  "outDir": "../dist/web-dev",
  "publishDir": "../dist/web"
}
