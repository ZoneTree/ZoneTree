<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>15.0</LangVersion>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <RootNamespace>ZoneTree.WalSoak</RootNamespace>
    <!-- The linked simulator predates nullable annotations. -->
    <NoWarn>$(NoWarn);CS8618;CS8600</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/ZoneTree/ZoneTree.csproj" />
    <!-- Reuse the tested simulator without referencing NUnit or the test assembly. -->
    <Compile Include="../../src/ZoneTree.UnitTests/PowerLossFileStreamProvider.cs" Link="Simulation/PowerLossFileStreamProvider.cs" />
  </ItemGroup>
</Project>
